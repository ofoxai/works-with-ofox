---
import Base from '../../layouts/Base.astro';
import WallList from '../../components/WallList.astro';
import { LOCALE_CODES, wallPath, t } from '../../lib/i18n';

const locale = 'en';
const localeUrls = Object.fromEntries(LOCALE_CODES.map((l) => [l, wallPath(l)]));
---
<Base locale={locale} title="Works with Ofox" description={t(locale, 'sub')} localeUrls={localeUrls}>
  <WallList locale={locale} />
</Base>
