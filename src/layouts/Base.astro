7 13.3167 50.6687 13.9513 50.4647 14.518C50.2721 15.0847 49.9887 15.5663 49.6147 15.963C49.2521 16.3597 48.8044 16.6657 48.2717 16.881C47.7391 17.0963 47.1441 17.204 46.4867 17.204ZM46.4867 15.538C47.1101 15.538 47.6031 15.351 47.9657 14.977C48.3284 14.5917 48.5097 14.0307 48.5097 13.294V11.934C48.5097 11.1973 48.3284 10.642 47.9657 10.268C47.6031 9.88267 47.1101 9.69 46.4867 9.69C45.8634 9.69 45.3704 9.88267 45.0077 10.268C44.6451 10.642 44.4637 11.1973 44.4637 11.934V13.294C44.4637 14.0307 44.6451 14.5917 45.0077 14.977C45.3704 15.351 45.8634 15.538 46.4867 15.538ZM52.1581 17L55.4391 12.546L52.3451 8.228H54.8441L55.8981 9.775L56.7141 10.999H56.8331L57.6491 9.775L58.7031 8.228H61.0151L57.9211 12.444L61.2021 17H58.6861L57.4791 15.232L56.6461 13.991H56.5271L55.6941 15.232L54.4871 17H52.1581Z" fill="black"/>
          </svg>
        </a>
        <span class="brand-divider" aria-hidden="true"></span>
        <a class="wall-name" href={wallPath(locale)}>Works with Ofox</a>
      </div>
      <div class="header-actions">
        <select class="lang-toggle" id="langSelect" aria-label={languageLabel(locale)}>
          {LOCALES.map((l) => (
            <option value={localeUrls[l.code]} data-loc={l.code} selected={l.code === locale}>{l.name}</option>
          ))}
        </select>
        <a class="btn-submit" href={submitUrl(locale)} target="_blank" rel="noopener">{t(locale, 'submit_link')}</a>
      </div>
    </div>
  </header>

  <slot />

  <footer class="footer">
    Powered by <a href="https://ofox.ai" target="_blank" rel="noopener">Ofox AI</a>{t(locale, 'footer_suf')} · <a href={readmeUrl(locale)} target="_blank" rel="noopener">GitHub</a>
  </footer>

  <script>
    // --- GTM/GA4 event tracking (埋点) via dataLayer, delegated for list + detail ---
    function trk(event: string, data: Record<string, unknown> = {}) {
      (window as any).dataLayer = (window as any).dataLayer || [];
      (window as any).dataLayer.push({ event, ...data });
    }

    const sel = document.getElementById('langSelect') as HTMLSelectElement | null;
    sel?.addEventListener('change', () => {
      // Persist the choice in the same NEXT_LOCALE cookie the rest of ofox.ai uses,
      // so an explicit language pick here sticks and propagates site-wide (and the
      // main-site middleware won't bounce a deliberate English choice back).
      const loc = sel.options[sel.selectedIndex]?.dataset.loc;
      if (loc) document.cookie = `NEXT_LOCALE=${loc};path=/;max-age=31536000;SameSite=Lax;Secure`;
      trk('wall_language_switch', { to_url: sel.value });
      if (sel.value) location.href = sel.value;
    });

    document.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement)?.closest('a, .cat-chip') as HTMLElement | null;
      if (!el) return;
      const link = el.tagName === 'A' ? (el as HTMLAnchorElement) : null;
      if (link && /(^|\.)app\.ofox\.ai$/i.test(link.hostname)) {
        // highest-value conversion: account signup / API-key creation on the
        // Ofox console (the integration guide's step links). Catch it wherever
        // it appears, regardless of how the link is styled.
        trk('wall_console_click', { href: link.href });
      } else if (el.classList.contains('card')) {
        trk('wall_app_click', { slug: el.getAttribute('data-slug') });
      } else if (el.classList.contains('btn-submit')) {
        trk('wall_submit_pr_click', { from: el.closest('.recruit-panel') ? 'recruit_panel' : 'header' });
      } else if (el.classList.contains('recruit-band') || el.classList.contains('hp-more')) {
        trk('wall_submit_pr_click', { from: el.classList.contains('hp-more') ? 'recruit_more' : 'recruit_band' });
      } else if (el.classList.contains('cat-chip') && !el.classList.contains('disabled')) {
        trk('wall_category_filter', { category: el.getAttribute('data-cat') });
      } else if (el.classList.contains('d-btn')) {
        // outbound: visit app / docs / source from a detail page
        trk('wall_outbound', { href: (el as HTMLAnchorElement).href });
      }
    });
  </script>
</body>
</html>
