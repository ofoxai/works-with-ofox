---
import AppCard from './AppCard.astro';
import { apps, categoryCounts, CATEGORIES } from '../lib/apps';
import { t, tagLabel, r, submitUrl } from '../lib/i18n';

interface Props { locale: string; }
const { locale } = Astro.props;

const counts = categoryCounts();
const catsPresent = Object.keys(counts).length;
const ossCount = apps.filter((a) => a.openSource).length;
const statIcons = ['▶', '✦', '⭐'];
const stats = [
  [apps.length, t(locale, 'stat_apps')],
  [catsPresent, t(locale, 'stat_cats')],
  [ossCount, t(locale, 'stat_oss')],
] as const;

const isEmpty = apps.length === 0;
const submit = submitUrl(locale);
const perkChips = [
  ['💰', r(locale, 'p_cash')],
  ['🤝', r(locale, 'p_partner')],
  ['✨', r(locale, 'p_show')],
  ['🎁', r(locale, 'p_refer')],
] as const;
---
<div class="hero">
  <h1>
    {t(locale, 'hero_before')}<span class="accent">Ofox</span>{t(locale, 'hero_after')}
    <span class="verified" style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;background:var(--copper);border-radius:50%;color:#fff;font-size:14px;margin-left:6px">✓</span>
  </h1>
  <div class="sub">{t(locale, 'sub')}</div>
  {!isEmpty && <div class="actions">{t(locale, 'submit_q')} </div>}
  {!isEmpty && <div class="stats">
    {stats.map(([n, label], i) => (
      <div class="stat-item">
        <div class="stat-num"><span class="stat-icon">{statIcons[i]}</span>{n}</div>
        <div class="stat-label">{label}</div>
      </div>
    ))}
  </div>}
</div>

{isEmpty ? (
  <section class="recruit-panel">
    <div class="recruit-panel-inner">
      <h2>{r(locale, 'headline')}</h2>
      <p class="lead">{r(locale, 'lead')}</p>
      <div class="perk-chips">
        {perkChips.map(([ico, label]) => (
          <span class="perk-chip"><span aria-hidden="true">{ico}</span> {label}</span>
        ))}
      </div>
      <div class="recruit-cta">
        <a class="btn-submit" href={submit} target="_blank" rel="noopener">{r(locale, 'cta')}</a>
        <a class="recruit-more" href={submit} target="_blank" rel="noopener">{r(locale, 'more')}</a>
      </div>
      <div class="ghosts" aria-hidden="true">
        <div class="ghost">{r(locale, 'ghost')}</div>
        <div class="ghost">{r(locale, 'ghost')}</div>
        <div class="ghost">{r(locale, 'ghost')}</div>
      </div>
    </div>
  </section>
) : (
  <>
    <div class="recruit-band-wrap">
      <a class="recruit-band" href={submit} target="_blank" rel="noopener">🎁 {r(locale, 'band')} <span class="arrow">→</span></a>
    </div>

    <div class="search-wrap">
      <input type="search" id="searchInput" placeholder={t(locale, 'search')} aria-label={t(locale, 'search')} />
    </div>

    <div class="cat-filter" id="catFilter">
      <button type="button" class="cat-chip active" data-cat="all" aria-pressed="true">{t(locale, 'all')}<span class="cat-count">{apps.length}</span></button>
      {CATEGORIES.map((cat) => {
        const n = counts[cat] || 0;
        return (
          <button type="button" class={`cat-chip${n === 0 ? ' disabled' : ''}`} data-cat={cat} aria-pressed="false" disabled={n === 0}>
            {tagLabel(locale, cat)}<span class="cat-count">{n}</span>
          </button>
        );
      })}
    </div>

    <div class="grid" id="appGrid">
      {apps.map((app) => <AppCard app={app} locale={locale} />)}
      <div class="empty" id="emptyMsg" role="status" aria-live="polite" style="display:none">{t(locale, 'empty')}</div>
    </div>
  </>
)}

<script>
  const grid = document.getElementById('appGrid');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#appGrid .card'));
  const empty = document.getElementById('emptyMsg');
  const search = document.getElementById('searchInput') as HTMLInputElement;
  const chips = Array.from(document.querySelectorAll<HTMLElement>('.cat-chip'));
  let activeCat = 'all';

  function apply() {
    const q = (search.value || '').toLowerCase().trim();
    let shown = 0;
    cards.forEach((card) => {
      const tags = (card.dataset.tags || '').split(' ');
      const hay = (card.dataset.name || '') + ' ' + (card.dataset.desc || '') + ' ' + tags.join(' ');
      const okCat = activeCat === 'all' || tags.includes(activeCat);
      const okQ = !q || hay.indexOf(q) !== -1;
      const show = okCat && okQ;
      card.style.display = show ? '' : 'none';
      if (show) shown++;
    });
    if (empty) empty.style.display = shown === 0 ? '' : 'none';
  }

  chips.forEach((chip) => {
    if ((chip as HTMLButtonElement).disabled) return;
    chip.addEventListener('click', () => {
      activeCat = chip.dataset.cat || 'all';
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('active', on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      apply();
    });
  });
  search?.addEventListener('input', apply);
</script>
