{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ofox App",
  "description": "Schema for apps that work with Ofox",
  "type": "object",
  "required": ["name", "description", "url", "category", "tags", "date_added"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "应用名称"
    },
    "category": {
      "type": "string",
      "enum": ["integration", "powered-by"],
      "description": "上墙类别（必填）：integration = 用户在你的应用里填自己的 Ofox API Key（需填 docs）；powered-by = 你的产品本身基于 Ofox 构建（docs 选填，审核时邮件核实 Ofox 账户及用量）"
    },
    "description": {
      "description": "一句话介绍（1-2 句，每种语言最多 300 字符）。可填单个字符串，或按语言的对象 {en, zh, ...}（必须含 en 作为回退；缺的语言回退到 en）",
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 300 },
        {
          "type": "object",
          "required": ["en"],
          "minProperties": 1,
          "additionalProperties": false,
          "propertyNames": { "enum": ["en", "zh", "zh-TW", "ja", "ko", "ru", "es", "fr", "de", "pt"] },
          "patternProperties": { ".*": { "type": "string", "minLength": 1, "maxLength": 300 } }
        }
      ]
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "应用链接"
    },
    "docs": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "Ofox 集成文档链接。category=integration 必填（指向你站点上说明如何配置 Ofox 的页面）；category=powered-by 选填"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["chat", "coding", "productivity", "creative", "research", "other"]
      },
      "description": "分类标签"
    },
    "open_source": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "开源仓库地址（选填）"
    },
    "date_added": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "添加日期 YYYY-MM-DD"
    }
  }
}
